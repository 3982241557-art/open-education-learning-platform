# ─────────────────────────────────────────────────────────────
#  后端环境变量模板
# ─────────────────────────────────────────────────────────────
#
#  【本地开发】
#
#      cp .env.example .env
#
#  然后把 ``DEEPSEEK_API_KEY`` 换成你自己的真 Key。
#
#  【云平台部署】
#
#  **不要**用这个文件部署——在 Zeabur / Railway / Render 的后台界面里
#  直接填变量名和值。平台注入的环境变量**优先级高于**本文件。
#
#  ⚠️ ``.env`` 已被 ``.gitignore`` 忽略，**不会**被提交到 GitHub。
#     但 ``.env.example`` **会**被提交——所以里面只能放占位符。
#
#  ─────────────────────────────────────────────────────────────
#  必填
#  ─────────────────────────────────────────────────────────────
#
#  模型密钥。**没有它平台不会假装自己能回答**——这是唯一真正必填的。

DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ─────────────────────────────────────────────────────────────
#  模型端点（一般不用改）
# ─────────────────────────────────────────────────────────────
#
# 默认值适用于 DeepSeek 官方。任何 OpenAI 协议兼容的端点都能用，
# 比如硅基流动、通义千问、OpenRouter、Ollama。

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────
#  跨域来源（可选）
# ─────────────────────────────────────────────────────────────
#
#  允许哪些前端域名跨域访问后端，逗号分隔。
#
#      ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.zeabur.app
#
#  【什么时候需要填】
#
#  只在**浏览器直连后端**时才需要——也就是前端设置了
#  ``NEXT_PUBLIC_API_BASE_URL`` 并且不走 Next 的 rewrite 代理。
#
#  【最常见的部署组合】
#
#  * 前端 Vercel + 后端 Render，前端**走代理**（NEXT_PUBLIC_API_BASE_URL 留空）
#    → **不需要填**。rewrite 在服务端转发，没有 CORS 问题。
#  * 前端 Vercel + 后端 Render，前端**直连**
#    → 填前端的 Vercel 域名。
#
#  【不填会怎样】
#
#  放行所有来源。平台没有登录、没有 Cookie 会话，
#  ``allow_credentials=False``，所以不会造成越权。
#  等以后加了登录再收紧也不迟。

ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────
#  GitHub 令牌（可选）
# ─────────────────────────────────────────────────────────────
#
#  用于 GitHub 开源教育资源的大面积筛选。
#
#      GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
#
#  不填也能工作——只是走匿名配额（每小时 60 次搜索请求），
#  大面积筛选会被限速，跑到一半要等。填了是 5000 次/小时。
#
#  获取地址：https://github.com/settings/tokens
#  权限勾选 public_repo 就够（只需要读公开仓库）。

GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
#  端口与监听地址（一般不用改）
# ─────────────────────────────────────────────────────────────
#
#  云平台会注入 ``PORT``——不用管。
#  ``HOST`` 保持 ``0.0.0.0``：容器里监听 127.0.0.1 的话外部连不上。

PORT=8001
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
#  日志（可选）
# ─────────────────────────────────────────────────────────────

# 是否在终端打印每轮组装好的完整提示词（排查用）。
# 生产环境建议关掉——那会打印用户的学习内容。
SEEK_LOG_PROMPT=false

# uvicorn 日志级别：critical / error / warning / info / debug。
LOG_LEVEL=info
