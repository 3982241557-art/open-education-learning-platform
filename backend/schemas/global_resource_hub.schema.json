{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seek-learning.local/schemas/global_resource_hub.schema.json",
  "title": "全网公开教学视频资源中台",
  "description": "平台的视频资源注册中心。每个分类是一类公开课专区，分类下挂真实可播的公开教学视频。每条资源都带 interactive_nodes 时间戳交互数组与 fallback_url 备用源。",
  "type": "object",
  "required": ["hub"],
  "properties": {
    "$schema": { "type": "string" },
    "hub": {
      "type": "object",
      "required": ["id", "title", "categories"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "depth": { "type": "string" },
        "status": { "type": "string" },
        "updated_at": { "type": "string" },
        "exploration_summary": { "type": "string" },
        "metadata": { "type": "object" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/category" }
        }
      }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "required": ["id", "title", "resources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "integer" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resource" }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "title", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "default": "video" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "provider": { "type": "string" },
        "url": {
          "type": "string",
          "description": "主源地址。YouTube 走 react-player 原生支持，B 站走 iframe 嵌入，直链 mp4 走 <video>。",
          "pattern": "^https?://"
        },
        "fallback_url": {
          "type": "string",
          "description": "备用源地址——主源加载失败或超时时自动切换。当前统一指向 B 站国内直连镜像；后续可替换为云盘 / OSS / 国内对象存储上的同款 mp4 直链。",
          "pattern": "^https?://"
        },
        "ai_context": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "meta": { "type": "object" },
        "captions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "text"],
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "interactive_nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["timestamp", "keyword"],
            "properties": {
              "timestamp": { "type": "number", "minimum": 0 },
              "keyword": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": ["concept", "question", "quote", "warning"]
              },
              "context": { "type": "string" },
              "hint": { "type": "string" },
              "context_label": { "type": "string" }
            }
          }
        },
        "is_default": { "type": "boolean" }
      }
    }
  }
}
