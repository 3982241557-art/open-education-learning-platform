{
  "name": "seek-learning-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync:data && npm run build:k12 && npm run build:content && npm run build:authentic && npm run build:hanzi && npm run build:pinyin && npm run verify:authentic",
    "sync:data": "node ../scripts/sync-static-data.mjs",
    "build:k12": "node ../scripts/build-k12-static.mjs",
    "build:content": "node ../scripts/build-k12-content.mjs",
    "build:authentic": "node ../scripts/build-authentic-curriculum.mjs",
    "verify:authentic": "node ../scripts/verify-authentic-data.mjs",
    "verify:k12": "node ../scripts/verify-k12-data.mjs",
    "harvest:k12": "node ../scripts/harvest-k12.mjs --apply",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "prebuild:static": "npm run sync:data && npm run build:k12 && npm run build:content && npm run build:authentic && npm run build:hanzi && npm run build:pinyin && npm run verify:authentic",
    "build:static": "NEXT_DIST_DIR=.next-build NEXT_PUBLIC_STATIC_EXPORT=true next build && node ../scripts/patch-gh-pages-404.mjs",
    "start": "NEXT_DIST_DIR=.next-build next start -p 3000",
    "serve:static": "npx serve out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:hanzi": "node ../scripts/build-hanzi-data.mjs",
    "build:pinyin": "node ../scripts/build-hanzi-pinyin.mjs"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "html2canvas": "^1.4.1",
    "jsxgraph": "^1.14.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "mafs": "^0.21.0",
    "mermaid": "^12.2.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-player": "^2.16.0",
    "recharts": "^3.11.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "pinyin-pro": "^3.29.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
